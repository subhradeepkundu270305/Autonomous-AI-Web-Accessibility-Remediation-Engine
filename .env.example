# ─── Postgres ────────────────────────────────────────────────────────────────
# Used by docker-compose.yml and the backend Prisma client
POSTGRES_USER=a11y_user
POSTGRES_PASSWORD=a11y_pass
POSTGRES_DB=a11y_db
POSTGRES_PORT=5432

# Full Prisma connection string (backend reads this)
DATABASE_URL="postgresql://a11y_user:a11y_pass@localhost:5432/a11y_db?schema=public"

# ─── Gemini AI ───────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── JWT Auth ────────────────────────────────────────────────────────────────
# Use a long random string (e.g. openssl rand -base64 64)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── Backend server ──────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Allowed CORS origins (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Max scan requests per IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# ─── Scan settings ───────────────────────────────────────────────────────────
# Max time (ms) to wait for Playwright page load
SCAN_TIMEOUT_MS=30000

# Max HTML size (bytes) sent to Gemini (trim if larger)
GEMINI_HTML_MAX_BYTES=50000

# Where to store screenshots and patch files (relative to backend/)
UPLOADS_DIR=./uploads

# ─── Frontend ────────────────────────────────────────────────────────────────
# Vite uses VITE_ prefix for client-exposed vars
VITE_API_BASE_URL=http://localhost:3001
