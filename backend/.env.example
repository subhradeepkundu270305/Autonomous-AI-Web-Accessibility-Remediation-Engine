# Backend Environment Variables
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (Prisma SQLite by default, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Gemini AI API Key (Get yours at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Auth Secret (At least 32 random characters)
JWT_SECRET=change_me_to_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=7d

# Rate Limiting & Scan Timeouts
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5
SCAN_TIMEOUT_MS=30000
GEMINI_HTML_MAX_BYTES=50000
UPLOADS_DIR=./uploads
